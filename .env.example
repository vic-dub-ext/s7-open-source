# S7 configuration. Copy to .env and fill in what you have.
# The app starts and runs stages S0-S1 with no keys set at all;
# each later stage fails gracefully, naming the missing key, the first time it needs one.

# --- Extend: parsing (S2) and classification (S3) only ---
EXTEND_API_KEY=

# --- LLM providers: schema contract induction (S5), semantic judge (S8) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Model selection (provider + model string; no model names are hardcoded in stages) ---
S7_ANTHROPIC_MODEL=claude-sonnet-5
S7_OPENAI_MODEL=gpt-5

# --- Article / supplement discovery (free, no key needed for basic use) ---
# Europe PMC and Unpaywall are used unauthenticated by default.
UNPAYWALL_EMAIL=

# --- Ontology lookups (rate-limited, cached aggressively; no key needed) ---
# Ensembl REST, EBI OLS4

# --- Storage ---
S7_DATA_DIR=./data
S7_DB_PATH=./data/s7.db

# Nothing to configure for S3's classifier: the taxonomy (src/s7/taxonomy.py)
# is sent as an inline Extend classify config on every call, not a saved
# processor -- so there's no account-specific ID to provision here.
